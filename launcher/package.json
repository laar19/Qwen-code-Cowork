{
  "name": "qwen-code-companion",
  "version": "1.0.0",
  "description": "Companion panel for Qwen-Code with LiteLLM proxy for API compatibility",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run dev:electron\"",
    "dev:electron": "tsc --project src/main/tsconfig.json && electron .",
    "build": "tsc -b && vite build",
    "transpile:electron": "tsc --project src/main/tsconfig.json",
    "dist:linux": "bun run transpile:electron && bun run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  }
}